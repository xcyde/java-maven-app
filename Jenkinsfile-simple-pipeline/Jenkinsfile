#!/usr/bin/env groovy

def gv

pipeline {
    agent any
    tools {
        maven 'Maven'
    }
    stages {
        stage("init") {
            steps {
                script {
                    gv = load "script.groovy"
                }
            }
        }
        stage("Checkout SCM") {
            steps {
                script {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/jenkins-jobs']],  // выбираем нужную ветку
                        userRemoteConfigs: [[url: 'https://gitlab.com/nanuchi/java-maven-app.git']],
                        extensions: [
                            [$class: 'CloneOption', shallow: false, noTags: false, reference: '', timeout: 600]  // Увеличиваем таймаут до 10 минут
                        ]
                    ])
                }
            }
        }
        stage("build jar") {
            steps {
                script {
                    gv.buildJar()
                }
            }
        }
        stage("build image") {
            steps {
                script {
                    gv.buildImage()
                }
            }
        }
        stage("deploy") {
            steps {
                script {
                    gv.deployApp()
                }
            }
        }
    }
}
